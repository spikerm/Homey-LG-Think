{
  "id": "com.rexm.lgthinq",
  "version": "0.7.16",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "LG ThinQ",
    "nl": "LG ThinQ"
  },
  "description": {
    "en": "Connect LG ThinQ appliances to Homey and control them intelligently with Energy-aware automation.",
    "nl": "Koppel LG ThinQ-apparaten aan Homey en stuur ze slim aan met energieprijsbewuste automatisering."
  },
  "category": "appliances",
  "brandColor": "#A50034",
  "author": {
    "name": "Rex"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [
    "homey:manager:api"
  ],
  "homepage": "https://github.com/spikerm/Homey-LG-Think",
  "support": "https://github.com/spikerm/Homey-LG-Think/issues",
  "api": {
    "testPush": {
      "method": "POST",
      "path": "/test-push"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "send_lg_notification",
        "title": {
          "en": "Send LG ThinQ notification",
          "nl": "Stuur LG ThinQ melding"
        },
        "titleFormatted": {
          "en": "Send LG ThinQ notification: [[message]]",
          "nl": "Stuur LG ThinQ melding: [[message]]"
        },
        "args": [
          {
            "name": "message",
            "type": "text",
            "title": {
              "en": "Message",
              "nl": "Bericht"
            },
            "placeholder": {
              "en": "The washer is ready",
              "nl": "De wasmachine is klaar"
            }
          }
        ]
      }
    ]
  }
}
